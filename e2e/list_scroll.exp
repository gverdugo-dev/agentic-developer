# list_scroll.exp: browse-list scrolling in the skills view.
#
# The fixture yields 33 skill groups and a 35-row terminal shows 28 list
# rows, so reaching the bottom forces the window to follow the selection.
# Every j/k step waits for the position counter before sending the next key.

source [file join [file dirname [info script]] lib harness.tcl]

boot

step "initial scan done"
await "1/2"

step "switch to the skills view: 33 groups"
send "2"
await "1/33"

step "walk to the bottom, one event-driven step at a time"
for {set i 2} {$i <= 33} {incr i} {
    send "j"
    await "$i/33"
}

step "the last row is visible and selected"
await "scroll-30"

step "and back up a few"
foreach i {32 31 30} {
    send "k"
    await "$i/33"
}

quit
step "ok"
